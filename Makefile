# read environment variables from external FILE
ifneq ($(GLOBAL_ENV),1)
ENV_FILE ?= local.env
ifneq ($(ENV_FILE),/dev/null)
include $(ENV_FILE)
export $(shell sed '/^\#/d; s/=.*//' $(ENV_FILE))
endif
endif

.PHONY: all
all: install-dependencies sumservice.toml

.PHONY: clean
clean:
	rm -Rf sumservice.toml env

.PHONY: install-dependencies deps
install-dependencies deps:
	@command -v cargo || (echo "Missing dependency: cargo)">&2 && false)
	@command -v rustc || (echo "Missing dependency: rustc">&2 && false)
	@command -v curl || (echo "Missing dependency: curl">&2 && false)
	@command -v python3 || (echo "Missing dependency: python3">&2 && false)
	@command -v nc || (echo "Missing dependency: nc (netcat)">&2 && false)
	@command -v envsubst || (echo "Missing dependency: envsubst (On Debian/Ubuntu: apt install gettext-base)">&2 && false)
	@command -v clam > /dev/null || cargo install --git https://codeberg.org/proycon/clam --branch clam-4.0 || (echo "Failed to install clam">&2 && false)
ifeq ($(GLOBAL_ENV),1)
	python3 -m pip install --break-system-packages git+https://github.com/proycon/ATRIUM_summarization@clam-4.0 #this is temporary until merged
else
	$(MAKE) env
endif

env:
	@echo "--- Setting up virtual environment ---">&2
	[ ! -d env ] && python3 -m venv env \
		&& . env/bin/activate \
		&& pip install --upgrade pip \
		&& pip install git+https://github.com/proycon/ATRIUM_summarization@clam-4.0 #this is temporary until merged

sumservice.toml: sumservice.template.toml
	envsubst < $< >$@
	@sed -i '1i # WARNING: DO NOT EDIT THIS FILE DIRECTLY! IT IS GENERATED FROM $<, EDIT THAT ONE INSTEAD' $@

.PHONY: docker
docker:
	docker build -t proycon/sumservice:latest .

.PHONY: docker-dev
docker-dev:
	docker build -t proycon/sumservice:dev .

.PHONY: run
run: sumservice.toml | install-dependencies
ifeq ($(GLOBAL_ENV),1)
	clam --config $< $(CLAM_EXTRA)
else
	. env/bin/activate && exec clam --config $< $(CLAM_EXTRA)
endif

.PHONY: check
check: sumservice.toml | install-dependencies
ifeq ($(GLOBAL_ENV),1)
	clam --check --config $< $(CLAM_EXTRA)
else
	. env/bin/activate && exec clam --check --config $< $(CLAM_EXTRA)
endif



